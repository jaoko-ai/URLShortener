# Copy this file to .env and adjust values for your machine.
# Vite only exposes variables that start with VITE_.

# Base URL of the ASP.NET API (no trailing slash).
# Local default from launchSettings.json is http://localhost:5062
VITE_API_BASE_URL=http://localhost:5062

# Origin used to display short links in the UI.
# This should match the public URL the API uses for redirects.
VITE_PUBLIC_SHORT_BASE_URL=http://localhost:5062
