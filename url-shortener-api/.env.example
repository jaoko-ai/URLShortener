# Optional local secrets. Prefer user-secrets or appsettings.Development.json
# for ASP.NET. Do not commit real values.

# PostgreSQL
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=URLShortener;Username=postgres;Password=yourpassword

# JWT
Jwt__Issuer=Shortpath
Jwt__Audience=ShortpathWeb
Jwt__Key=replace-with-a-long-random-secret-at-least-32-chars
Jwt__ExpiresMinutes=10080

# Public origin used when building short URLs in API responses
PublicBaseUrl=http://localhost:5062

# CORS origin of the Vite app
Cors__Origin=http://localhost:5173
